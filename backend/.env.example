# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-too
JWT_EXPIRES_HOURS=12

# Leave unset locally to use SQLite. In production, point at Azure SQL:
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Gmail SMTP (App Password required — see services/email_service.py)
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_RECEIVING_EMAIL=devbymanan@gmail.com

# reCAPTCHA v3 — leave blank locally to skip verification in dev
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Seed script admin credentials — change before deploying
ADMIN_USERNAME=manan
ADMIN_PASSWORD=change-me-before-launch
